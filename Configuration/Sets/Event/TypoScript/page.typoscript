##############
#### PAGE ####
##############

['{$GedankenfolgerEvent.cssmode}' == 'css_bootstrap']
    page {
        includeCSS {
            event = EXT:gedankenfolger_event/Resources/Public/Css/bootstrap_events.css
        }
    }
[END]

['{$GedankenfolgerEvent.cssmode}' == 'scss_bootstrap']
    page {
        includeCSS {
            event = EXT:gedankenfolger_event/Resources/Public/Scss/bootstrap_events.scss
            event.outputfile = EXT:gedankenfolger_event/Resources/Public/Css/bootstrap_events.css
            event.sourceMap = true
        }
    }
[END]
